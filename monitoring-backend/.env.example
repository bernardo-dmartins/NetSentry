# Server
NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0

# Security
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS / Frontend
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (SQLite)
DB_STORAGE=./database.sqlite
DB_LOGGING=false
DB_SYNC_ALTER=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=netsentry

# Logging / Debug
LOG_LEVEL=info
DEBUG_MODE=false

# Monitoring
PING_TIMEOUT=5000
HTTP_TIMEOUT=5000
MONITORING_RETRIES=2
MAX_CONCURRENT_CHECKS=10
GLOBAL_CYCLE_INTERVAL=30000
CHECK_RESULTS_RETENTION_DAYS=30
ALLOW_INSECURE_TLS=false

# Rate limiting
DISABLE_RATE_LIMIT=false
ENABLE_RATE_LIMIT_IN_DEV=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX_REQUESTS=600
RATE_LIMIT_POLLING_WINDOW_MS=60000
RATE_LIMIT_POLLING_MAX_REQUESTS=1800
RATE_LIMIT_SYSTEM_RESET_WINDOW_MS=3600000
RATE_LIMIT_SYSTEM_RESET_MAX_REQUESTS=5

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="NetSentry <no-reply@example.com>"
ALERT_EMAIL_TO=alerts@example.com
